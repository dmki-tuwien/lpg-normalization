# Credentials used for Neo4j
USERNAME=neo4j
PASSWORD=password

# Connection details
MEMGRAPH_URI=bolt://memgraph:7687
MEMGRAPH_DATABASE=memgraph
NEO4J_URI=neo4j://neo4j:7687
NEO4J_DATABASE=neo4j

# Log levels
NEO4J_dbms_logs_debug_level=ERROR
NEO4J_server_logs_user_leve=ERROR

# Paths
GRAPHS_PATH=/absolute/path/to/graphs

# Specific setting for Docker Desktop
# TC_HOST=host.docker.internal
